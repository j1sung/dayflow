# Base: GitHub Node.gitignore (includes Next.js and TypeScript caches)
# https://github.com/github/gitignore/blob/41862c835a7bd7e03373f1dbe1d2350f47063b71/Node.gitignore

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Directory for instrumented libs generated by jscoverage/JSCover
lib-cov

# Coverage directory used by tools like istanbul
coverage
*.lcov

# nyc test coverage
.nyc_output

# Grunt intermediate storage (https://gruntjs.com/creating-plugins#storing-task-files)
.grunt

# Bower dependency directory (https://bower.io/)
bower_components

# node-waf configuration
.lock-wscript

# Compiled binary addons (https://nodejs.org/api/addons.html)
build/Release

# Dependency directories
node_modules/
jspm_packages/

# Snowpack dependency directory (https://snowpack.dev/)
web_modules/

# TypeScript cache
*.tsbuildinfo

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional stylelint cache
.stylelintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# dotenv environment variable files
.env
.env.*
!.env.example

# parcel-bundler cache (https://parceljs.org/)
.cache
.parcel-cache

# Next.js build output
.next
out

# Nuxt.js build / generate output
.nuxt
dist
.output

# NitroJS
.nitro/

# Gatsby files
.cache/
# Comment in the public line in if your project uses Gatsby and not Next.js
# https://nextjs.org/blog/next-9-1#public-directory-support
# public

# vuepress build output
.vuepress/dist

# vuepress v2.x temp directory
.temp

# Sveltekit cache directory
.svelte-kit/

# vitepress build output
**/.vitepress/dist

# vitepress cache directory
**/.vitepress/cache

# Docusaurus cache and generated files
.docusaurus

# Serverless directories
.serverless/

# FuseBox cache
.fusebox/

# DynamoDB Local files
.dynamodb/

# Firebase cache directory
.firebase/

# TernJS port file
.tern-port

# Stores Visual Studio Code versions used for testing Visual Studio Code extensions
.vscode-test

# pnpm
.pnpm-store

# yarn v3
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# Vite files
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
.vite/

# Astro generated types
.astro/

# Turbo Repo
.turbo

# DayFlow existing local and credential rules.
# Local environment variables; commit only sanitized examples.
.env
.env.*
!.env.example
!.env.*.example

# Keep real credentials in these directories, never in source files.
.secrets/
secrets/
.credentials/
credentials/

# OAuth clients, cached access/refresh tokens, and service accounts.
credentials.json
credentials-*.json
client_secret*.json
client-secret*.json
oauth-credentials*.json
service-account*.json
service_account*.json
*-firebase-adminsdk-*.json
authorized_user.json
token.json
tokens.json
access_token*.json
refresh_token*.json

# Private keys and credential bundles.
*.pem
*.key
*.p12
*.pfx
*.jks

# Local dependencies, caches, and generated output.
node_modules/
.next/
.nuxt/
.vercel/
.netlify/
/dist/
/build/
/coverage/
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
*.tsbuildinfo
*.log

# Machine-specific files.
.DS_Store
Thumbs.db
Desktop.ini

# DayFlow: local personal data and authenticated browser state.
# Store real user exports and backups here; keep sanitized fixtures in tests/fixtures/.
/private-data/
/personal-data/
/local-data/
/backups/
/exports/
playwright/.auth/

# Supabase CLI state; migrations and config.toml remain tracked.
supabase/.temp/
supabase/.branches/

# Next.js/deployment generated files.
next-env.d.ts
.netlify/
.vercel/
