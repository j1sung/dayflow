# Local: http://127.0.0.1:3000; production: your Vercel HTTPS origin
APP_URL=http://127.0.0.1:3000
# Google Cloud OAuth web client. Redirect URI: APP_URL/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate a random secret of at least 32 characters. Never use a public variable.
SESSION_SECRET=
# Optional cloud account. Use ONLY the public publishable key, never service_role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
